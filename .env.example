APP_NAME="Meriz API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# L'application Meriz : adresse vers laquelle le serveur renvoie après
# avoir validé un lien envoyé par email. En développement, le serveur Vite.
FRONTEND_URL=http://localhost:5173
FRONTEND_EMAIL_VERIFIED_PATH=/email-verifie
FRONTEND_PASSWORD_RESET_PATH=/reinitialiser-mot-de-passe

# Origines autorisées à appeler l'API depuis un navigateur ou une
# webview, séparées par des virgules. Des origines complètes, avec le
# schéma : c'est l'entête Origin qui est comparée telle quelle. En
# production, y mettre l'adresse de l'application et les origines Tauri
# (tauri://localhost, etc.).
# Attention, REVERB_ALLOWED_ORIGINS plus bas ne prend pas la même forme.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Validité du lien de vérification d'email, en minutes.
AUTH_VERIFICATION_EXPIRE=60

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Hôtes autorisés à ouvrir un websocket, séparés par des virgules.
# Des hôtes seuls, sans schéma ni port : Reverb extrait l'hôte de
# l'entête Origin avant de comparer. « https://app.exemple.fr » ne
# correspondrait donc jamais, il faut « app.exemple.fr ».
# '*' convient en développement. En production, lister les hôtes de
# l'application, dont ceux de la webview Tauri (localhost,
# tauri.localhost) si le logiciel de bureau doit avoir le direct.
REVERB_ALLOWED_ORIGINS=*
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log en développement : les emails partent dans storage/logs/laravel.log.
# En production, un service réel (smtp, ses, postmark, resend) par ces
# variables, et APP_URL doit être l'adresse publique de l'API, sinon les
# liens signés envoyés par email sont faux.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ACADEMIC_EXTRA_DOMAINS=

SANCTUM_TOKEN_EXPIRATION=43200

DOCUMENTS_MAX_CONTENT_BYTES=2097152
DOCUMENTS_MAX_PER_USER=1000

ASSIGNMENTS_MAX_IMAGE_KB=2048
ASSIGNMENTS_MAX_PER_CLASSROOM=500

LESSONS_MAX_AUDIO_KB=16384
LESSONS_MAX_IMAGE_KB=2048

REVERB_MAX_REQUEST_SIZE=3145728
REVERB_APP_MAX_MESSAGE_SIZE=3145728
